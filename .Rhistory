library(readr)
library(here)
library(dplyr)
library(ggplot2)
library(fixest)
df <- read_csv(here("df.csv"))
library(table1)
library(kableExtra)
table1(~ relocation + post + treat + pub_count + career_age + senior,
data = df)
vars <- c("relocation", "post", "treat", "pub_count", "career_age", "senior")
cor_matrix <- cor(df[vars])
cor_matrix
df <- df %>%
filter(year >= 2010) %>%
mutate(event_time = year - 2015)
event_model_relocation <- feols(
relocation ~ i(event_time, treat, ref = -1) + career_age |
author_id + year + institution_state,
data = df
)
par(mar = c(4, 4, 1, 2))
iplot(event_model_relocation,
main = "",
xlab = "Years since (until) policy",
ylab = "Changes in relocation",
ref.line = 0)
library(texreg)
library(lmtest)
library(rlang)
library(modelsummary)
save_model_table <- function(model_list,
model_names = NULL,
path,
stars = c("*" = 0.1, "**" = 0.05, "***" = 0.01),
gof = c("nobs", "adj.r.squared")) {
# use model names (if have)
if (!is.null(model_names)) {
if (length(model_names) != length(model_list)) {
stop("Length of model_names must match number of models.")
}
model_list <- setNames(model_list, model_names)
}
# generate and save tables
modelsummary::modelsummary(
model_list,
stars = stars,
gof_map = gof,
output = path
)
}
df <- df %>% mutate(post_treat = post * treat)
model1.1 <- feols(relocation ~ post_treat + pub_cum |
institution_state + year + author_id,
data = df)
model1.2 <- feols(relocation ~ post_treat * pub_cum |
institution_state + year + author_id,
data = df)
model1.3 <- feols(relocation ~ post_treat * pub_cum|
institution_state + year + author_id,
data = df %>% filter(senior == 1))
model1.4 <- feols(relocation ~ post_treat * pub_cum|
institution_state + year + author_id,
data = df %>% filter(senior == 0))
mnames <- c("Baseline", "Interaction", "Senior", "Junior")
save_model_table(
model_list = list(model1.1, model1.2, model1.3, model1.4),
model_names = mnames,
path = here("Paper_Analysis", "Table 3.docx")
)
df <- df %>% mutate(post_treat = post * treat)
model2.1 <- feols(relocation ~ post_treat + pub_cum |
institution_state + year + author_id,
data = df %>% filter(wi_sample == 1))
model2.2 <- feols(relocation ~ post_treat * pub_cum |
institution_state + year + author_id,
data = df %>% filter(wi_sample == 1))
model2.3 <- feols(relocation ~ post_treat * pub_cum|
institution_state + year + author_id,
data = df %>% filter(wi_sample == 1 & senior == 1))
model2.4 <- feols(relocation ~ post_treat * pub_cum|
institution_state + year + author_id,
data = df %>% filter(wi_sample == 1 & senior == 0))
mnames <- c("Baseline", "Interaction", "Senior", "Junior")
dir.create("TestFolder", showWarnings = TRUE, recursive = TRUE)
save_model_table(
model_list = list(model2.1, model2.2, model2.3, model2.4),
model_names = mnames,
path = here("TestFolder", "Table 4.docx")
)
